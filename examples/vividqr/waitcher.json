{
  "$schema": "https://waitcher.dev/schema/project-v1.json",
  "schemaVersion": 1,
  "project": "VividQR",
  "environments": {
    "production": {
      "baseUrl": "https://www.vividqr.app"
    }
  },
  "defaults": {
    "interval": 1800,
    "timeout": 15,
    "failureThreshold": 2
  },
  "monitors": [
    {
      "key": "home",
      "type": "http",
      "name": "VividQR",
      "path": "/",
      "settings": {
        "method": "HEAD",
        "expectedStatus": 200
      }
    },
    {
      "key": "tls",
      "type": "certificate",
      "name": "VividQR / certificate"
    },
    {
      "key": "home-look",
      "type": "visual",
      "name": "VividQR / home page look",
      "path": "/",
      "failureThreshold": 10
    }
  ]
}
