{
  "$schema": "https://waitcher.dev/schema/project-v1.json",
  "schemaVersion": 1,
  "project": "Leaf Arcade",
  "environments": {
    "production": {
      "baseUrl": "https://leafarcade.com"
    }
  },
  "defaults": {
    "interval": 1800,
    "timeout": 15,
    "failureThreshold": 2
  },
  "monitors": [
    {
      "key": "home",
      "type": "http",
      "name": "Leaf Arcade",
      "path": "/",
      "settings": {
        "method": "HEAD",
        "expectedStatus": 200
      }
    },
    {
      "key": "tls",
      "type": "certificate",
      "name": "Leaf Arcade / certificate"
    },
    {
      "key": "klondike",
      "type": "browser",
      "name": "Leaf Arcade / Klondike opens",
      "entry": "tests/klondike.e2e.ts",
      "timeout": 30
    },
    {
      "key": "home-look",
      "type": "visual",
      "name": "Leaf Arcade / home page look",
      "path": "/",
      "failureThreshold": 10
    }
  ]
}
